<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources for every build in this repository: nuget.org only, so a
     machine-wide NuGet config (offline sources, missing nuget.org) cannot break
     restore. The wasm stage uses logic/wasm-nuget.config instead. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
