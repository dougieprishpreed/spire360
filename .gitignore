# build outputs
build/
**/build/
bin/
obj/
*.o
*.obj
*.exe
*.xex
*.pdb
*.ilk
# generated by the pipeline (contains translated game code: never commit)
gen/
# ...except the translated XDK test programs (tools/gen_xdk_tests.py; no game code)
!xdk/selftest/gen/
!xdk/bench/gen/
out/
logic/lib/
*.wasm
# player data
packs/
*.s3p
__pycache__/
*.pyc
.vs/
# player data extracted from the game (pck_tool extract)
data/
# XDK build logs
xdk/build_logs/
xdk/probe/probe_results.txt

# Godot download for fonts (convert.py fetch-godot)
converter/.cache/
# Visual Studio / XDK build folders and files
xdk/*/Release/
xdk/*/Debug/
ipch/
*.sdf
*.suo
*.user
# local logs and archives (bundles, uploads)
*.log
*.zip
*.zip.[0-9][0-9][0-9]
# local work folders: decompiled game code, run traces, packs, screenshots
# (all made from the player's game files: never commit)
decomp/
traces/
work/

# the Windows installer's build
installer/bin/
installer/obj/
# working notes (kept locally, not in the repository)
notes/
