<Application x:Class="Spire360Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#F2E6CF"/>
    <SolidColorBrush x:Key="Dim" Color="#A89A80"/>
    <SolidColorBrush x:Key="Gold" Color="#D9B45A"/>
    <SolidColorBrush x:Key="Ember" Color="#E0603A"/>
    <SolidColorBrush x:Key="Panel" Color="#211B17"/>
    <SolidColorBrush x:Key="PanelEdge" Color="#4A3B2C"/>
    <FontFamily x:Key="Ornate">Gabriola, Palatino Linotype, Georgia</FontFamily>
    <FontFamily x:Key="Body">Segoe UI</FontFamily>

    <Style x:Key="GoldButton" TargetType="Button">
      <Setter Property="Foreground" Value="#1A1410"/>
      <Setter Property="FontFamily" Value="{StaticResource Body}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1"
                    BorderBrush="#F0D58A">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#EBCB7A" Offset="0"/>
                  <GradientStop Color="#B98C36" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontFamily" Value="{StaticResource Body}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1"
                    BorderBrush="{StaticResource PanelEdge}" Background="#2B231D">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
