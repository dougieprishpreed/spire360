<Project Sdk="Microsoft.NET.Sdk">
  <!-- Same checks as PatchTest, compiled with NativeAOT against the patched
       mock assembly: proves patched IL is accepted by ILC. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <PatchedDir Condition="'$(PatchedDir)' == ''">$(MSBuildThisFileDirectory)build/patcher/patched/</PatchedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PatchTest/Program.cs" />
    <Reference Include="sts2"><HintPath>$(PatchedDir)sts2.dll</HintPath></Reference>
    <ProjectReference Include="../../Spire.HookBridge/Spire.HookBridge.csproj" />
  </ItemGroup>
</Project>
