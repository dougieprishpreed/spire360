extends SceneTree
func _init():
	var sub := Gradient.new()
	sub.colors = PackedColorArray([Color(1, 0, 0, 1), Color(0, 0, 1, 0.5)])
	var tex := GradientTexture1D.new()
	tex.gradient = sub
	tex.width = 64
	tex.set_meta("int", 42)
	tex.set_meta("big", 1 << 40)
	tex.set_meta("float", 1.5)
	tex.set_meta("str", "héllo")
	tex.set_meta("sname", &"name")
	tex.set_meta("path", NodePath("../a/b:prop"))
	tex.set_meta("v2", Vector2(1.25, -2))
	tex.set_meta("v2i", Vector2i(3, 4))
	tex.set_meta("rect", Rect2(1, 2, 3, 4))
	tex.set_meta("color", Color(0.25, 0.5, 0.75, 1))
	tex.set_meta("arr", [1, "two", 3.0, null, true])
	tex.set_meta("dict", {"k": Vector3(1, 2, 3), 7: [NodePath("x")]})
	tex.set_meta("bytes", PackedByteArray([1, 2, 3, 4, 5]))
	tex.set_meta("ints", PackedInt32Array([-1, 2, 3]))
	tex.set_meta("floats", PackedFloat32Array([0.5, 2.5]))
	tex.set_meta("strings", PackedStringArray(["a", "bc"]))
	tex.set_meta("v2s", PackedVector2Array([Vector2(1, 2), Vector2(3, 4)]))
	tex.set_meta("xform", Transform2D(0.0, Vector2(5, 6)))
	tex.set_meta("ext", load("res://grad_opaque_256.png"))
	ResourceSaver.save(tex, "res://test_plain.res")
	ResourceSaver.save(tex, "res://test_compressed.res", ResourceSaver.FLAG_COMPRESS)
	quit()
